# Copy this file to .env and fill in the values. (.env is kept out of Git.)

# Email reports (Gmail App Password, not the account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_TO=
# Optional: comma-separated CC for the Playwright run report
# GMAIL_CC=
# Optional: CC for the PDI report emails (PDI.spec.ts, report:pdi-daily). Only used when the run
# fully passes; a failed run's report isn't emailed, and dry runs go to GMAIL_TO only.
# PDI_CC=Name <name@example.com>, Other <other@example.com>

# ---- Optional ----
# Browser: chrome (default), msedge, or chromium (after "npx playwright install chromium")
# BROWSER_CHANNEL=chromium
# Use a credentials file other than resources/credentials.json (e.g. a CI secret)
# CREDENTIALS_FILE=
# GSTR Report: output folder and date range (dd-mm-yyyy)
# GSTR_OUTPUT_DIR=
# GSTR_FROM=01-09-2026
# GSTR_TO=24-09-2026
# Enquiry List: date range (dd-mm-yyyy); default 07-09-2026 to today
# ENQ_FROM=07-09-2026
# ENQ_TO=28-09-2026
# PDI: vehicles to list on the PDI page (default 500), VIN sheet location
# PDI_TOP=500
# PDI_VIN_FILE=
# MIS checker: only these pages, skip email, time limit, browser profile folder
# MIS_PAGES=CRM Reports,Workshop Reports
# MIS_SEND_EMAIL=0
# MIS_MAX_MINUTES=60
# MIS_PROFILE_DIR=
