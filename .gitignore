
# Dependencies
node_modules/

# Playwright / test run output (regenerated on every run)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Everything the scripts generate: reports, downloads and the MIS check's saved DMS login
# (Output/MIS/dms-profile). Contains customer names, phone numbers and addresses.
/Output/

# Secrets - use .env.example / resources/credentials.example.json as templates
.env
resources/credentials.json

# Reference data for the PDI spec (VIN / battery / motor / charger numbers)
resources/VIN*.xlsx
resources/VIN*.csv

# Local tooling
.claude/
*.log
~$*

# Browser automation scratch files
.playwright-mcp/

# Python
__pycache__/
